                    <div class="time-details">Family time + Light walk | Mental reset | No screens</div>
                </div>

                <div class="time-block study">
                    <div class="time-header">
                        <div class="time-badge">📚 8PM</div>
                    </div>
                    <div class="time-title">Light Reading (1hr)</div>
                    <div class="time-details">NCERT Revision | Formula memorization | Easy concepts</div>
                </div>

                <div class="time-block wake-up">
                    <div class="time-header">
                        <div class="time-badge">🌙 10PM</div>
                    </div>
                    <div class="time-title">Sleep</div>
                    <div class="time-details">7-8 hours quality sleep | Dream of success | Recovery mode</div>
                </div>
            </div>
        </section>

        <!-- 🔥 NEON SUBJECT PROGRESS CARDS WITH RICH BACKSIDE STATS -->
        <section id="subjects">
            <h1 style="text-align: center; font-size: 2.5rem; margin-bottom: 2rem; background: linear-gradient(45deg, #667eea, #f093fb); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">📊 Subject Progress</h1>
            <div class="subjects">
                <div class="subject-card physics">
                    <div class="card-inner">
                        <div class="card-front">
                            <div class="subject-icon">⚛️</div>
                            <h2>Physics</h2>
                            <p>14/20 Chapters</p>
                        </div>
                        <div class="card-back">
                            <div class="back-stats">
                                <div class="stat-item">
                                    <span class="stat-label">Overall Progress</span>
                                    <span class="stat-value">70%</span>
                                </div>
                                <div class="stat-item">
                                    <span class="stat-label">Chapters Done</span>
                                    <span class="stat-value">14/20</span>
                                </div>
                                <div class="stat-item">
                                    <span class="stat-label">Practice Tests</span>
                                    <span class="stat-value">8/12</span>
                                </div>
                            </div>
                            <div class="progress-container">
                                <div class="progress-label">
                                    <span>Chapter Completion</span>
                                    <span>70%</span>
                                </div>
                                <div class="progress-bar">
                                    <div class="progress-fill" style="width: 70%; background: linear-gradient(90deg, #00d4ff, #0099cc);"></div>
                                </div>
                            </div>
                            <div class="topics-list">
                                Mechanics, Thermodynamics, Waves, Electrostatics
