                    <div class="time-details">30 min relaxation | Review flashcards | Mental recharge</div>
                </div>

                <div class="time-block study">
                    <div class="time-header">
                        <div class="time-badge">🧪 9AM</div>
                    </div>
                    <div class="time-title">Chemistry (2hrs)</div>
                    <div class="time-details">Organic Reactions + Practice | 25 questions | Mechanism diagrams</div>
                </div>

                <div class="time-block gym">
                    <div class="time-header">
                        <div class="time-badge">💪 11AM</div>
